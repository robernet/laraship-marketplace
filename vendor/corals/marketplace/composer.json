{
    "name": "corals/marketplace",
    "description": "Corals Marketplace",
    "keywords": [
        "corals",
        "marketplace"
    ],
    "homepage": "https://github.com/coralsio/marketplace",
    "license": "MIT",
    "authors": [
        {
            "name": "corals",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Corals\\Modules\\Marketplace\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "laravel/pint": "^1.0"
    },
    "require": {
        "shippo/shippo-php": "1.*",
        "corals/utility-rating": "^10.0.0",
        "corals/utility-comment": "^10.0.0",
        "corals/utility-wishlist": "^10.0.0",
        "corals/utility-lov":"^10.0.0",
        "corals/cms":"^10.0.0",
        "corals/advert": "^10.0.0",
        "corals/referral": "^10.0.0",
        "corals/messaging": "^10.0.0",
        "corals/payment": "^10.0.0",
        "corals/subscriptions": "^10.0.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Corals\\Modules\\Marketplace\\MarketplaceServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.laraship.com"
        }
    ],
    "minimum-stability": "dev"
}
